{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadMachinesAndImages",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeImages"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "LaunchFromTheImagesIntoTheSubnet",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-1::image/ami-0045d7fc2ad003464",
        "arn:aws:ec2:us-east-1::image/ami-0c20dc14952c0c073",
        "arn:aws:ec2:us-east-1:532217001883:subnet/subnet-0984e347d9bb3e01b",
        "arn:aws:ec2:us-east-1:532217001883:security-group/sg-00478a75c50869398",
        "arn:aws:ec2:us-east-1:532217001883:network-interface/*"
      ]
    },
    {
      "Sid": "LaunchOnlyMachinesItTags",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-1:532217001883:instance/*",
        "arn:aws:ec2:us-east-1:532217001883:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/managed-by": "hanzo-compute"
        }
      }
    },
    {
      "Sid": "TagOnlyAtLaunch",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:us-east-1:532217001883:instance/*",
        "arn:aws:ec2:us-east-1:532217001883:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "RunInstances"
        }
      }
    },
    {
      "Sid": "StartStopTerminateOnlyItsOwn",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:TerminateInstances"
      ],
      "Resource": "arn:aws:ec2:us-east-1:532217001883:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/managed-by": "hanzo-compute"
        }
      }
    },
    {
      "Sid": "ReadNetworkOut",
      "Effect": "Allow",
      "Action": "cloudwatch:GetMetricData",
      "Resource": "*"
    }
  ]
}
