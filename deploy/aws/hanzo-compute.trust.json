{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EgressAlone",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::532217001883:oidc-provider/hanzo.id"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "hanzo.id:aud": "hanzo-egress",
          "hanzo.id:sub": "admin/hanzo-egress"
        }
      }
    }
  ]
}
