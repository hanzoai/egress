# Install to /etc/egress/env, root:root 0400, on the LUKS root.
#
# This file is the whole configuration. There is no orchestrator to ask, which
# is the point: this process runs where a cloud API token does not reach.

# NO MNEMONIC HERE. The identity KMS authorizes is the innermost secret on this
# box — it derives the key that unlocks every provider credential — so it is
# sealed to the TPM and loaded as a unit credential, never as an environment
# variable this file could carry:
#
#   systemd-creds encrypt --with-key=tpm2 --name=mnemonic - /etc/egress/mnemonic.cred
#
# Everything below is configuration, not secret. This file holds no credential.

# Who may spend. A token must name this issuer and carry this audience.
# Audience has no default on purpose: a service accepting any audience accepts
# a token minted for a different app.
EGRESS_ISSUER=https://hanzo.id
EGRESS_JWKS=https://hanzo.id/.well-known/jwks.json
EGRESS_AUDIENCE=hanzo-egress

# Where the credentials live. KMSPath is this service's own identity path.
EGRESS_KMS=zap://kms.hanzo.ai:9999
EGRESS_KMS_ORG=hanzo
EGRESS_KMS_PATH=hanzo/egress

# Inbound ZAP. Bind to the interface callers reach, never 0.0.0.0 on a host
# with a public address.
EGRESS_LISTEN=:9653

EGRESS_RPM=600
EGRESS_DEADLINE=5m
