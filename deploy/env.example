# Install to /etc/egress/env, root:root 0400, on the LUKS root.
#
# This file is the whole configuration. There is no orchestrator to ask, which
# is the point: this process runs where a cloud API token does not reach.

# NO MNEMONIC HERE. The identity KMS authorizes is the innermost secret on this
# box — it derives the key that unlocks every provider credential — so it is
# sealed to the TPM and loaded as a unit credential, never as an environment
# variable this file could carry:
#
#   systemd-creds encrypt --with-key=tpm2 --name=mnemonic - /etc/egress/mnemonic.cred
#
# Everything below is configuration, not secret. This file holds no credential.

# Who may spend. A token must name this issuer and carry this audience.
# Audience has no default on purpose: a service accepting any audience accepts
# a token minted for a different app.
# The key set is published under the IAM prefix, not at the host root: the root
# spelling answers 404, and a JWKS is fetched on the first call rather than at
# boot — so the wrong URL here starts cleanly and then refuses every caller as
# unidentifiable, which reads like a token problem rather than a config one.
EGRESS_ISSUER=https://hanzo.id
EGRESS_JWKS=https://hanzo.id/v1/iam/.well-known/jwks
EGRESS_AUDIENCE=hanzo-egress

# Where the credentials live. KMSPath is this service's own identity path.
# HTTPS, because this process runs OFF the cluster and that is the whole design.
# The ZAP endpoint is a direct dial to a port the public edge does not carry —
# kms.hanzo.ai resolves to the CDN, which proxies 443 and nothing else — so a
# zap:// endpoint here is one that cannot be reached from where egress lives. Use
# zap:// only from inside the cluster, where the port is real.
EGRESS_KMS=https://kms.hanzo.ai
EGRESS_KMS_ORG=hanzo
EGRESS_KMS_PATH=hanzo/egress

# The http transport authenticates as a machine identity rather than by envelope
# signature, so these two go with an https endpoint and are ignored with zap://.
# The matching secret is sealed, never written here:
#   systemd-creds encrypt --with-key=tpm2 --name=client-secret - /etc/egress/client-secret.cred
EGRESS_IAM=https://hanzo.id
EGRESS_CLIENT_ID=

# Inbound ZAP. Bind to the interface callers reach, never 0.0.0.0 on a host
# with a public address.
EGRESS_LISTEN=:9653

EGRESS_RPM=600
EGRESS_DEADLINE=5m
